{
	"name": "cdk-cross-stack-reference1",
	"version": "0.1.0",
	"bin": {
		"cdk-cross-stack-reference1": "bin/cdk-cross-stack-reference1.js"
	},
	"scripts": {
		"preinstall": "pnpm audit",
		"test": "jest",
		"format": "oxfmt",
		"lint": "oxlint",
		"check": "oxfmt && oxlint --fix",
		"bootstrap": ". ./.env && cdk bootstrap",
		"list": "cdk list",
		"synth": "cdk synth",
		"deploy": ". ./.env && cdk deploy --all --require-approval never",
		"diff": ". ./.env && cdk diff --all",
		"destroy": ". ./.env && cdk destroy --all",
		"build": "tsc",
		"watch": "tsc -w",
		"cdk": "cdk"
	},
	"dependencies": {
		"aws-cdk-lib": "2.271.0",
		"constructs": "^10.8.1",
		"tsx": "^4.23.15"
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@types/node": "26.6.3",
		"aws-cdk": "2.1143.0",
		"jest": "^30.5.2",
		"ts-jest": "^29.4.14",
		"ts-node": "^10.9.2",
		"typescript": "~7.0.2"
	}
}
